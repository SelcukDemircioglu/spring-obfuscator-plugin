<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.3</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>ev-management-app</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>EV Management Application</name>
    <description>Electric Vehicle Management REST API - Spring Boot 3 Test App for Obfuscation Plugin</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- Spring Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Data JPA -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Spring Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- PostgreSQL Driver -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Spring Boot Maven Plugin -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- Obfuscator Plugin -->
            <plugin>
                <groupId>com.obfuscator</groupId>
                <artifactId>spring-obfuscator-maven-plugin</artifactId>
                <version>1.0.0</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>obfuscate</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <level>LEVEL_3_ADVANCED</level>
                    <preserveSpringBeans>true</preserveSpringBeans>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Test LEVEL_4_ENCRYPTED: mvn package -P level4 -->
        <profile>
            <id>level4</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.obfuscator</groupId>
                        <artifactId>spring-obfuscator-maven-plugin</artifactId>
                        <version>1.0.0</version>
                        <executions>
                            <execution>
                                <id>obfuscate-level4</id>
                                <phase>process-classes</phase>
                                <goals><goal>obfuscate</goal></goals>
                            </execution>
                        </executions>
                        <configuration>
                            <level>LEVEL_4_ENCRYPTED</level>
                            <preserveSpringBeans>true</preserveSpringBeans>
                            <mainClass>com.example.EvManagementApp</mainClass>
                            <!-- encryptionKey: optional, omit for random key per build -->
                        </configuration>
                    </plugin>
                    <!-- Override spring-boot packaging to use EncryptedLauncher -->
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <configuration>
                            <mainClass>com.obfuscator.runtime.EncryptedLauncher</mainClass>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
